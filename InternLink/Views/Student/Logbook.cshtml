@model Placement
@{
    ViewData["Title"] = "Logbook";
}

<div class="dashboard" style="max-width:1100px;">
    <div class="page-header">
        <h2>Weekly Logbook &mdash; @Model.CompanyName</h2>
        <a class="btn btn-primary" asp-controller="Student" asp-action="CreateLogbookEntry" asp-route-placementId="@Model.Id">📝 Log a Week</a>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">@TempData["Success"]</div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-error">@TempData["Error"]</div>
    }

    <div class="content-card">
        @if (!Model.LogbookEntries.Any())
        {
            <p>No log entries yet.</p>
        }
        else
        {
            <div class="table-wrap">
                <table class="data-table">
                    <thead>
                        <tr>
                            <th>Week</th>
                            <th>Dates</th>
                            <th>Hours</th>
                            <th>Tasks / Skills</th>
                            <th>Status</th>
                            <th>Coordinator Comment</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var log in Model.LogbookEntries.OrderBy(l => l.WeekNumber))
                        {
                            <tr>
                                <td>Week @log.WeekNumber</td>
                                <td style="white-space:nowrap;">@log.WeekStartDate.ToString("MMM d") &ndash; @log.WeekEndDate.ToString("MMM d")</td>
                                <td>@log.HoursLogged.ToString("0.#") h</td>
                                <td style="max-width:320px;">
                                    <div>@log.TasksCompleted</div>
                                    @if (!string.IsNullOrWhiteSpace(log.SkillsApplied))
                                    {
                                        <div style="font-size:12px; color:var(--text-secondary); margin-top:0.25rem;">Skills: @log.SkillsApplied</div>
                                    }
                                </td>
                                <td><span class="badge badge-@log.Status.ToString().ToLower()">@log.Status</span></td>
                                <td>@(string.IsNullOrWhiteSpace(log.CoordinatorComment) ? "—" : log.CoordinatorComment)</td>
                                <td>
                                    @if (log.Status != LogbookStatus.Approved)
                                    {
                                        <a class="btn btn-secondary" style="padding:0.35rem 0.75rem; font-size:12px;" asp-controller="Student" asp-action="EditLogbookEntry" asp-route-id="@log.Id">Edit</a>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>

    <a class="btn btn-secondary" asp-controller="Student" asp-action="PlacementDetails" asp-route-id="@Model.Id">Back to Placement</a>
</div>
