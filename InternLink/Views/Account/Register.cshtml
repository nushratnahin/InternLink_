@model RegisterViewModel
@{
    ViewData["Title"] = "Sign up";
}

<div class="form-page">
    <div class="form-card">
        <h2>Create your account</h2>
        <p class="form-subtitle">Supervisors don't need an account — you'll receive a one-time evaluation link by email instead.</p>

        <div asp-validation-summary="ModelOnly" class="validation-summary-errors"></div>

        <form asp-controller="Account" asp-action="Register" method="post">
            <div class="form-group">
                <label asp-for="FullName">Full name</label>
                <input asp-for="FullName" type="text" />
                <span asp-validation-for="FullName" class="field-validation-error"></span>
            </div>
            <div class="form-group">
                <label asp-for="Email">Email</label>
                <input asp-for="Email" type="email" autocomplete="username" />
                <span asp-validation-for="Email" class="field-validation-error"></span>
            </div>
            <div class="form-group">
                <label asp-for="Role">I am a...</label>
                <select asp-for="Role">
                    <option value="Student">Student</option>
                    <option value="Coordinator">Coordinator</option>
                    <option value="Faculty">Faculty</option>
                </select>
                <span asp-validation-for="Role" class="field-validation-error"></span>
            </div>
            <div class="form-group">
                <label asp-for="Department">Department / Office (optional)</label>
                <input asp-for="Department" type="text" />
            </div>
            <div class="form-group">
                <label asp-for="StudentIdNumber">Student ID (students only)</label>
                <input asp-for="StudentIdNumber" type="text" placeholder="e.g. CSE-2021-0142" />
            </div>
            <div class="form-row">
                <div class="form-group">
                    <label asp-for="Password">Password</label>
                    <input asp-for="Password" type="password" autocomplete="new-password" />
                    <span asp-validation-for="Password" class="field-validation-error"></span>
                </div>
                <div class="form-group">
                    <label asp-for="ConfirmPassword">Confirm password</label>
                    <input asp-for="ConfirmPassword" type="password" autocomplete="new-password" />
                    <span asp-validation-for="ConfirmPassword" class="field-validation-error"></span>
                </div>
            </div>
            <button type="submit" class="btn btn-primary" style="width:100%;">Create account</button>
        </form>

        <p class="form-footer-link">Already have an account? <a asp-controller="Account" asp-action="Login">Log in</a></p>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
