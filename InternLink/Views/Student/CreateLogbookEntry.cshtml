@model LogbookEntryFormViewModel
@{
    ViewData["Title"] = "Submit Weekly Log";
}

<div class="form-page">
    <div class="form-card">
        <h2>Submit weekly log</h2>
        <p class="form-subtitle">Log your hours, tasks, skills applied, and what you learned this week. You can save a draft and finish it later, or submit it straight to your coordinator.</p>

        <div asp-validation-summary="ModelOnly" class="validation-summary-errors"></div>

        <form asp-controller="Student" asp-action="CreateLogbookEntry" method="post">
            <input type="hidden" asp-for="PlacementId" />
            <div class="form-row">
                <div class="form-group">
                    <label asp-for="WeekNumber">Week number (1-12)</label>
                    <input asp-for="WeekNumber" type="number" min="1" max="12" />
                    <span asp-validation-for="WeekNumber" class="field-validation-error"></span>
                </div>
                <div class="form-group">
                    <label asp-for="HoursLogged">Hours logged (1-60)</label>
                    <input asp-for="HoursLogged" type="number" min="1" max="60" step="0.5" />
                    <span asp-validation-for="HoursLogged" class="field-validation-error"></span>
                </div>
            </div>
            <div class="form-row">
                <div class="form-group">
                    <label asp-for="WeekStartDate">Week start date</label>
                    <input asp-for="WeekStartDate" type="date" />
                    <span asp-validation-for="WeekStartDate" class="field-validation-error"></span>
                </div>
                <div class="form-group">
                    <label asp-for="WeekEndDate">Week end date</label>
                    <input asp-for="WeekEndDate" type="date" />
                    <span asp-validation-for="WeekEndDate" class="field-validation-error"></span>
                </div>
            </div>
            <div class="form-group">
                <label asp-for="TasksCompleted">Tasks completed</label>
                <textarea asp-for="TasksCompleted" placeholder="Describe the engineering tasks you performed this week."></textarea>
                <span asp-validation-for="TasksCompleted" class="field-validation-error"></span>
            </div>
            <div class="form-group">
                <label asp-for="SkillsApplied">Skills applied</label>
                <input asp-for="SkillsApplied" type="text" placeholder="e.g. C#, EF Core, PostgreSQL, Docker" />
            </div>
            <div class="form-group">
                <label asp-for="ChallengesAndLearnings">Challenges & learnings</label>
                <textarea asp-for="ChallengesAndLearnings" placeholder="Blockers you resolved, decisions you made, what you learned."></textarea>
            </div>

            <div style="display:flex; gap:0.75rem;">
                <button type="submit" name="IsDraft" value="true" class="btn btn-secondary" style="flex:1;">Save as draft</button>
                <button type="submit" name="IsDraft" value="false" class="btn btn-primary" style="flex:1;">Submit for review</button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
