@model GradePlacementViewModel
@{
    ViewData["Title"] = "Grade Placement";
}

<div class="form-page">
    <div class="form-card">
        <h2>Grade @Model.StudentName</h2>
        <p class="form-subtitle">@Model.CompanyName</p>

        <div asp-validation-summary="ModelOnly" class="validation-summary-errors"></div>

        <div class="content-card" style="margin-bottom:1.5rem;">
            <p><strong>Logbook score:</strong> @Model.LogbookScore.ToString("0.0") / 100 (weight 30%)</p>
            <p><strong>Supervisor score:</strong> @Model.SupervisorScore.ToString("0.0") / 100 (weight 40%)</p>
            <p style="font-size:12px; color:var(--text-secondary); margin-top:0.5rem;">Defense score below carries the remaining 30% of the final grade.</p>
        </div>

        <form asp-controller="Faculty" asp-action="GradePlacement" method="post">
            <input type="hidden" asp-for="PlacementId" />
            <input type="hidden" asp-for="StudentName" />
            <input type="hidden" asp-for="CompanyName" />
            <input type="hidden" asp-for="LogbookScore" />
            <input type="hidden" asp-for="SupervisorScore" />
            <input type="hidden" asp-for="SupervisorEvaluationSubmitted" />

            <div class="form-group">
                <label asp-for="DefenseScore">Defense score (0-100)</label>
                <input asp-for="DefenseScore" type="number" min="0" max="100" step="0.1" />
                <span asp-validation-for="DefenseScore" class="field-validation-error"></span>
            </div>

            <button type="submit" class="btn btn-primary" style="width:100%;">Save final grade</button>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
